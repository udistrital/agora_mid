}

ref rel_parametro_parametro_padre {
  parametros.parametro.id ?< parametros.parametro.parametro_padre_id
}

Table ubicaciones.tipo_lugar {
  ~id
  ~parametros_base
}

Table ubicaciones.lugar {
  ~id
  nombre varchar(100) [not null]
  tipo_lugar integer [not null]
  ~terceros_campos_auditoria
}

Ref rel_lugar_tipo_lugar {
  ubicaciones.tipo_lugar.id < ubicaciones.lugar.tipo_lugar
}

Ref rel_tercero_lugar_lugar_origen {
  ubicaciones.lugar.id ?< terceros.tercero.lugar_origen
}

Ref rel_datos_identificacion_lugar_ciudad_expedicion {
  ubicaciones.lugar.id ?< terceros.datos_identificacion.ciudad_expedicion
}

TableGroup terceros {
  note: 'Terceros CRUD'
  terceros.tipo_contribuyente
  terceros.tipo_tercero
  terceros.tipo_documento
  terceros.grupo_info_complementaria
  terceros.info_complementaria

  terceros.tercero
  terceros.info_complementaria_tercero
  terceros.tercero_tipo_tercero
  terceros.datos_identificacion
  terceros.seguridad_social_tercero
}

TableGroup parametros {
  note: 'Parametros CRUD'
  parametros.area_tipo
  parametros.tipo_parametro
  parametros.parametro
}

TableGroup ubicaciones {
  note: 'Ubicaciones CRUD'
  ubicaciones.tipo_lugar
  ubicaciones.lugar
}
