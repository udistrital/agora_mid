# Copiar a .env y ajustar los valores.
# Las variables ya exportadas en el proceso tienen prioridad sobre este archivo.

AGORA_MID_APP_NAME=agora_mid
AGORA_MID_HTTP_PORT=8080
AGORA_MID_RUN_MODE=dev

TERCEROS_CRUD_SERVICE=http://localhost:8081/
GESTION_PROVEEDORES_CRUD_SERVICE=http://localhost:8082/
PARAMETROS_CRUD_SERVICE=http://localhost:8083/
UBICACIONES_CRUD_SERVICE=http://localhost:8084/

# IDs de catálogo. Si se omiten, el MID los resuelve al arranque contra
# terceros_crud. Si se definen, no se consulta el catálogo para esos IDs.
MID_TIPO_CONTRIBUYENTE_NATURAL=1
MID_TIPO_CONTRIBUYENTE_JURIDICA=2
MID_TIPO_DOCUMENTO_NIT=7

# Tipo de proveedor para el dominio 2 (1 = natural, 2 = jurídica).
MID_TIPO_PROVEEDOR_NATURAL=1
MID_TIPO_PROVEEDOR_JURIDICO=2

# Tipos de parámetro usados para validar contactos y actividades CIIU.
# Si se omiten, el MID valida CIIU con "CIIU" y el canal solo por existencia.
MID_TIPO_PARAMETRO_CIIU=CIIU
MID_TIPO_PARAMETRO_CANAL_CONTACTO=MED_COMUNICACION

# Dominio 2 jurídico: parámetros y grupos de catálogo.
MID_TIPO_PARAMETRO_REGIMEN_CONTRIBUTIVO=REG_CONT
MID_TIPO_PARAMETRO_TIPO_CONFORMACION=TIPO_CONFORMACION
MID_GRUPO_PROCEDENCIA=PROCEDENCIA
MID_GRUPO_CARGO=Grupo_5
MID_GRUPO_PROVEEDOR_JURIDICO=PROVEEDOR_JURIDICO

# Overrides legacy por Id para códigos duplicados o dudosos de info_complementaria.
# El dominio 2 natural usa (código, grupo) y no depende de estos Ids.
# MID_INFOCOMP_DESCRIPCION=53
# MID_INFOCOMP_MIGRANTE=444
# MID_INFOCOMP_EPS=308
